# ==============================================================================
# Template for the local profile.
#
# application.properties makes local the default profile, but the real
# application-local.properties holds personal credentials and is ignored by
# git. A fresh clone therefore fails a plain ./gradlew bootRun.
#
# Usage:
#   cp src/main/resources/application-local.properties.example \
#      src/main/resources/application-local.properties
#
# Then replace the personal values. To skip filling values, run the dev
# profile instead; it has defaults for all of them:
#   ./gradlew bootRun --args='--spring.profiles.active=dev'
# ==============================================================================


# ==============================
# Datasource and JPA
# ==============================

# JDBC URL of the local MySQL.
spring.datasource.url=jdbc:mysql://localhost:3306/highteenday_db

# Database user.
spring.datasource.username=root

# Database password. Fill in your own.
spring.datasource.password=

# Hibernate never touches the schema; Flyway owns it (docs/MIGRATION.md).
spring.jpa.hibernate.ddl-auto=none

# Never runs schema.sql or data.sql.
spring.sql.init.mode=never


# ==============================
# Redis
# ==============================

# Redis host.
spring.data.redis.host=localhost

# Redis port.
spring.data.redis.port=6379


# ==============================
# CORS
# ==============================

# Browser origins allowed by CORS, the CSRF Origin check and the WebSocket
# handshake. Comma-separated.
app.cors.allowed-origins=http://localhost:3000


# ==============================
# JWT
# ==============================

# HMAC key that signs access and refresh tokens. Use a random string of at
# least 64 bytes; HS512 rejects shorter keys.
jwt.key=local-dev-jwt-signing-key-must-be-at-least-64-bytes-long-0123456789abcdef


# ==============================
# OAuth2 Login (Google)
# Real values are needed only to test Google login. Spring Boot fails to
# start with an empty client-id, so keep a dummy string otherwise.
# ==============================

# Google OAuth client ID.
spring.security.oauth2.client.registration.google.client-id=dummy-client-id

# Google OAuth client secret.
spring.security.oauth2.client.registration.google.client-secret=dummy-client-secret


# ==============================
# External Services
# Dummy values work unless the code actually calls the service.
# ==============================

# NEIS open API key (school info, meals, and schedules).
neis.api.key=dummy-neis-key

# S3 bucket for uploaded files.
cloud.aws.s3.bucket=highteenday-bucket-0906


# ==============================
# Logging
# ==============================

# Log level of the application packages.
logging.level.com.example.highteenday_backend=DEBUG

# p6spy SQL logging. Set true to print every SQL statement.
decorator.datasource.p6spy.enable-logging=false
