# environment/.env.perf 로 복사해서 사용 (실제 값은 커밋 금지)

# 어떤 데이터셋 프로파일의 MySQL 볼륨에 연결할지 결정한다 (perf-mysql-data-<값>).
# 프로파일마다 볼륨이 분리되므로 시드는 프로파일당 1회만 내면 되고, 전환은
# 이 값만 바꿔 up -d 하면 된다. 값과 실제 적재된 데이터는 스스로 맞춰야 한다 —
# environment/bootstrap.js 를 쓰면 불일치와 시드 중복 실행을 막아준다.
DATASET_PROFILE=medium

MYSQL_ROOT_PASSWORD=perfroot
MYSQL_DATABASE=highteenday
# 반드시 본인 로컬 전용 키를 생성해 채운다. 예제에 실제 키를 적어 두지 않는다 — 예제 파일은
# 커밋되므로 저장소를 읽을 수 있는 사람 전원에게 공유된다(E-34).
#   openssl rand -base64 64
#
# HS512는 최소 512비트(64바이트) 키가 필요하다 — 짧으면
# "signing key's size is ... not secure enough for the HS512 algorithm"로 로그인/회원가입이
# 500으로 실패한다(실측 확인됨). 아래는 openssl rand -base64 64 등으로 새로 생성해도 된다.
JWT_KEY=
# prod,perf 고정 (environment/README.md 참고):
#  - dev/local 프로파일은 AppStartupRunner(@Profile("!prod"))가 매 기동마다
#    DataInitializer.dataInit()으로 테스트 데이터를 심으려 하는데, 빈 DB에는 board가 없어
#    ResourceNotFoundException으로 기동 자체가 무한 크래시 루프에 빠진다(실측 확인됨).
#  - prod는 이 러너가 비활성이라 안전하지만, 쿠키 Domain=.highteenday.org + Secure=true를
#    하드코딩하고 있어 localhost+HTTP 테스트에서 세션 쿠키가 전혀 재전송되지 않는다
#    (실측 확인됨 — 로그인은 200인데 이후 모든 인증 요청이 401). perf 프로파일이 이 둘만
#    되돌린다(application-perf.properties).
SPRING_PROFILE=prod,perf
GRAFANA_PASSWORD=perf
# 아래 3개는 부하 테스트 경로(로그인/게시글/댓글 등)에서 실제로 쓰이지 않지만,
# 프로퍼티에 기본값이 없어 값이 없으면 앱 부팅 자체가 실패한다 — 더미로 충분.
GOOGLE_CLIENT_ID=perf-dummy-client-id
GOOGLE_CLIENT_SECRET=perf-dummy-client-secret
NEIS_API_KEY=perf-dummy-neis-key
S3_BUCKET=perf-dummy-bucket
