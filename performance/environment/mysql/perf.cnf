# 참고용 문서 — 실제로 적용되는 설정 아님.
#
# 이 파일은 마운트되지 않는다. docker-compose.perf.yml의 mysql 서비스 command: 블록이
# 아래 값들을 CLI 플래그로 직접 전달한다. 이유(실측 확인됨): Windows 호스트에서
# Docker Desktop이 바인드 마운트하는 설정 파일은 world-writable 권한으로 올라가고,
# mysqld는 world-writable 설정 파일을 경고만 남기고 조용히 무시한다 — buffer pool이
# 128MB 기본값으로 남는 등 의도한 튜닝이 하나도 적용되지 않은 채 기동에는 성공해서
# 알아채기 어렵다. 이 파일은 "의도한 값이 무엇인지" 사람이 읽기 위한 문서로만 남긴다.
# 실제 값을 바꾸려면 docker-compose.perf.yml의 command: 블록을 수정할 것.
[mysqld]
# ---- 메모리 (컨테이너 2GB 상한 기준) ----
innodb_buffer_pool_size = 1G
innodb_log_buffer_size  = 32M

# ---- 커넥션 ----
# HikariCP(max 10~20) x 앱 1대 + 관측 도구 여유분
max_connections = 200

# ---- 내구성/쓰기 (운영과 동일한 안전 설정 — 성능을 위해 낮추지 않는다.
#      낮춰서 얻는 개선은 운영에 적용할 수 없는 가짜 개선이다) ----
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1

# ---- 관측 ----
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 0.1              # 100ms 이상은 전부 기록
log_queries_not_using_indexes = 1
performance_schema = ON

# ---- 기타 ----
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+09:00'

# Token 엔티티는 @Table(name=...) 지정 없이 Hibernate 기본 네이밍으로 소문자 `token`을
# 쿼리하는데, Flyway 마이그레이션(V1__baseline.sql)은 대문자 `Token`으로 테이블을 만든다.
# macOS/Windows MySQL(대소문자 비구분 기본값)에서는 우연히 동작하지만, Linux(이 컨테이너의
# 기본값, lower_case_table_names=0)에서는 "Table 'token' doesn't exist"로 로그인/회원가입이
# 전부 500으로 실패한다(실측 확인됨 — 회원가입 시 Token 조회 쿼리에서 발생).
# ⚠ 이 설정은 MySQL 데이터 디렉터리 최초 초기화 시점에만 적용된다 — 이미 볼륨이 있다면
#   `docker compose down -v`로 볼륨을 지우고 처음부터 다시 띄워야 반영된다.
# ⚠ 이 프로젝트의 실제 운영 EC2 MySQL이 이 설정 없이 Linux 기본값으로 초기화되어 있다면
#   운영에서도 동일하게 로그인이 깨질 수 있다 — bottlenecks/BTL-008 참고, 별도 확인 필요.
lower_case_table_names = 1
