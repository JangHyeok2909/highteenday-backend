{
  "title": "HighTeenDay Performance Overview",
  "uid": "htd-perf-overview",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "fault-injection",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "red",
        "hide": false
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries", "title": "k6 RPS (요청 처리율)", "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 7 },
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total[30s]))", "legendFormat": "RPS" }
      ]
    },
    {
      "type": "timeseries", "title": "k6 Latency P50/P95/P99 (ms)", "id": 2,
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "1000 * histogram_quantile(0.50, sum(rate(k6_http_req_duration_seconds[30s])))", "legendFormat": "p50" },
        { "expr": "1000 * histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds[30s])))", "legendFormat": "p95" },
        { "expr": "1000 * histogram_quantile(0.99, sum(rate(k6_http_req_duration_seconds[30s])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "k6 Error Rate / VUs", "id": 3,
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 7 },
      "targets": [
        { "expr": "100 * (sum(rate(k6_http_reqs_total{expected_response=\"false\"}[30s])) or vector(0)) / clamp_min(sum(rate(k6_http_reqs_total[30s])), 0.0001)", "legendFormat": "error rate (%)" },
        { "expr": "max(k6_vus)", "legendFormat": "VUs" }
      ]
    },
    {
      "type": "timeseries", "title": "JVM Heap Used / Max", "id": 4,
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "GC Pause (p99, ms) / GC 빈도", "id": 5,
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 7 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "pause p99 (ms)" },
        { "expr": "sum(rate(jvm_gc_pause_seconds_count[1m])) * 60", "legendFormat": "GCs/min" }
      ]
    },
    {
      "type": "timeseries", "title": "Tomcat Threads (busy / max 400)", "id": 6,
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 7 },
      "targets": [
        { "expr": "tomcat_threads_busy_threads", "legendFormat": "busy" },
        { "expr": "tomcat_threads_current_threads", "legendFormat": "current" },
        { "expr": "tomcat_threads_config_max_threads", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "HikariCP (active / pending / max)", "id": 7,
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 7 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending (대기 스레드!)" },
        { "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "HikariCP 커넥션 획득 대기 p99 (ms)", "id": 8,
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 7 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(hikaricp_connections_acquire_seconds_bucket[1m])) by (le)) * 1000", "legendFormat": "acquire p99" }
      ]
    },
    {
      "type": "timeseries", "title": "MySQL threads_running / slow queries", "id": 9,
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 7 },
      "targets": [
        { "expr": "mysql_global_status_threads_running", "legendFormat": "threads_running" },
        { "expr": "rate(mysql_global_status_slow_queries[1m]) * 60", "legendFormat": "slow q/min" },
        { "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m]) * 60", "legendFormat": "row lock waits/min" }
      ]
    },
    {
      "type": "timeseries", "title": "Redis Hit Ratio / ops", "id": 10,
      "gridPos": { "x": 0, "y": 21, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 } },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))", "legendFormat": "hit ratio" },
        { "expr": "rate(redis_commands_processed_total[1m]) / 1000", "legendFormat": "kops/s" }
      ]
    },
    {
      "type": "timeseries", "title": "컨테이너 CPU (cores)", "id": 11,
      "gridPos": { "x": 8, "y": 21, "w": 8, "h": 7 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=~\"perf-(app|mysql|redis)\"}[1m])", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "timeseries", "title": "HTTP 서버 요청 p95 by URI (서버 관점, ms)", "id": 12,
      "gridPos": { "x": 16, "y": 21, "w": 8, "h": 7 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri)) * 1000", "legendFormat": "{{uri}}" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
